# Copy this file to .env and fill in real values. Never commit .env.

FLASK_ENV=development

# Required in production; a dev-only fallback is used automatically in development.
SECRET_KEY=change-me-to-a-long-random-string

# Defaults to a local SQLite file under instance/. Point this at a Postgres
# URL (e.g. postgresql://user:pass@host:5432/dbname) when you move to real hosting -
# no code changes needed, SQLAlchemy handles both.
DATABASE_URL=

# AI provider abstraction (app/ai/provider.py). Leave AI_PROVIDER=mock to run
# without any key - all AI-assisted features work with clearly-labeled mock output.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Set to true once served over HTTPS in production.
SESSION_COOKIE_SECURE=false

# --- Gmail draft creation (optional, existing feature) ---
# See README.md for how to obtain credentials.json. Requires the gmail.compose
# scope only - this app can create drafts but can never send or read email.
