# Copy this file to .env and fill in real values. Never commit .env.

FLASK_ENV=development

# Required in production; a dev-only fallback is used automatically in development.
SECRET_KEY=change-me-to-a-long-random-string

# Optional. Encrypts Gmail tokens at rest with its own key instead of one
# derived from SECRET_KEY, so rotating SECRET_KEY doesn't also invalidate
# every stored Gmail connection. Safe to leave unset - falls back to the
# SECRET_KEY-derived behavior with no migration needed either way.
TOKEN_ENCRYPTION_KEY=

# Defaults to a local SQLite file under instance/. Point this at a Postgres
# URL (e.g. postgresql://user:pass@host:5432/dbname) when you move to real hosting -
# no code changes needed, SQLAlchemy handles both.
DATABASE_URL=

# AI provider abstraction (app/ai/provider.py). Leave AI_PROVIDER=mock to run
# without any key - all AI-assisted features work, with an honest "AI not
# configured" message instead of AI-written narrative/tips. Set to
# "anthropic" plus ANTHROPIC_API_KEY, or "gemini" plus GEMINI_API_KEY, to
# enable those. (OPENAI_API_KEY is reserved for a future provider - no
# OpenAI implementation exists yet.)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=

# Set to true once served over HTTPS in production.
SESSION_COOKIE_SECURE=false

# Storage provider abstraction (app/documents/storage.py). Leave as "local"
# for dev/test - writes uploaded documents to UPLOAD_DIR on disk. Set to
# "s3" plus S3_BUCKET for production on any host that wipes local disk on
# deploy/restart (most PaaS hosts). S3_REGION/S3_ENDPOINT_URL are only
# needed for a non-AWS S3-compatible service (MinIO, a PaaS's own object
# storage) or a specific AWS region. S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY
# are optional - unset, boto3 falls back to its own default credential
# chain (env vars it reads itself, an IAM role, etc.).
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# Job source adapters (app/jobs/adapters/). Arbeitsagentur needs no
# credentials (see jobsearch.py) - Adzuna/Jooble are skipped from search
# entirely until their keys below are set, not an error either way.
#
# Adzuna: self-serve signup at developer.adzuna.com. IMPORTANT - free
# access is a 14-day trial only per Adzuna's Terms of Service, not
# indefinite free use; see JOB_SOURCES.md before relying on this in
# production past the trial window.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de

# Jooble: key is manually issued after submitting a request form at
# jooble.org/api/about (name/role/email/website) - not instant, allow lead
# time before it's usable.
JOOBLE_API_KEY=

# --- Gmail draft creation (optional, existing feature) ---
# See README.md for how to obtain credentials.json. Requires the gmail.compose
# scope only - this app can create drafts but can never send or read email.
